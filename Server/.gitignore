## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
[Pp]ublish/
publish.zip

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet Packages
*.nupkg
**/packages/*
*.snupkg

# Database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Sensitive files
appsettings.Development.json
appsettings.Local.json
*.pfx
*.key
.env
.env.local

# VS Code
.vscode/
.vs/

# Rider
.idea/

# User secrets
**/secrets.json

# Azure
*.PublishSettings
*.azurePubxml

# Logs
logs/
*.log

# OS generated files
.DS_Store
Thumbs.db
