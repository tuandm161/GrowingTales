<nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/">
            <i class="bi bi-book me-2"></i>GrowingTales
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/Story/Create">
                        <i class="bi bi-plus-circle me-1"></i>Tạo truyện
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Story">
                        <i class="bi bi-collection me-1"></i>Thư viện
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Subscription/Pricing">
                        <i class="bi bi-gem me-1"></i>Bảng giá
                    </a>
                </li>
            </ul>
            <ul class="navbar-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var avatarUrl = User.FindFirst("AvatarUrl")?.Value;
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" style="gap: 8px;">
                            @if (!string.IsNullOrEmpty(avatarUrl))
                            {
                                <img src="@avatarUrl" alt="Avatar" 
                                     class="rounded-circle" 
                                     style="width: 32px; height: 32px; object-fit: cover; border: 2px solid rgba(255,255,255,0.3); flex-shrink: 0;"
                                     onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='inline-block';">
                                <i class="bi bi-person-circle" style="display: none; font-size: 1.5rem; flex-shrink: 0;"></i>
                            }
                            else
                            {
                                <i class="bi bi-person-circle" style="font-size: 1.5rem; flex-shrink: 0;"></i>
                            }
                            <span class="text-nowrap">@User.Identity.Name</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/Story"><i class="bi bi-collection me-2"></i>Truyện của tôi</a></li>
                            <li><a class="dropdown-item" href="/Account/Profile"><i class="bi bi-person-gear me-2"></i>Hồ sơ</a></li>
                            <li><a class="dropdown-item" href="/Account/ChangePassword"><i class="bi bi-shield-lock me-2"></i>Đổi mật khẩu</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" href="/Account/Login">Đăng nhập</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-light btn-sm ms-2" href="/Account/Register">Đăng ký</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
