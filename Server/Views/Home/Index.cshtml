@{
    ViewData["Title"] = "Trang chủ";
    Layout = "_Layout";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="hero-title mb-4">
                    <i class="bi bi-book display-4 d-block mb-3"></i>
                    Tạo Truyện Cho Bé
                    <span class="hero-highlight d-block">Chỉ Trong Vài Phút</span>
                </h1>
                <p class="lead mb-4">
                    Biến ý tưởng của bạn thành những câu chuyện tuyệt vời với hình ảnh sinh động, 
                    được cá nhân hóa riêng cho bé yêu của bạn bằng công nghệ AI tiên tiến.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="/Story/Create" class="btn btn-light btn-lg">
                        <i class="bi bi-stars me-2"></i>Dùng Thử Miễn Phí
                    </a>
                    <a href="/Subscription/Pricing" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-gem me-2"></i>Xem Gói Đăng Ký
                    </a>
                </div>
                <p class="mt-3 opacity-75">
                    <i class="bi bi-gift me-1"></i>Tạo miễn phí 3 truyện đầu tiên - Không cần thẻ tín dụng
                </p>
            </div>
            <div class="col-lg-6 text-center">
                <div class="hero-visual">
                    <div class="display-1">📖✨</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="section bg-light">
    <div class="container">
        <div class="section-header">
            <h2>Tại Sao Chọn GrowingTales?</h2>
            <p>Công cụ tạo truyện thông minh nhất cho trẻ em Việt Nam</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card feature-card h-100">
                    <div class="feature-icon">✨</div>
                    <h5>AI Tạo Truyện Thông Minh</h5>
                    <p class="text-muted">Công nghệ AI tiên tiến tạo ra những câu chuyện độc đáo, phù hợp với độ tuổi của bé</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card feature-card h-100">
                    <div class="feature-icon">🎨</div>
                    <h5>Hình Ảnh Sinh Động</h5>
                    <p class="text-muted">Mỗi trang truyện đều có hình minh họa đẹp mắt, được tạo tự động bởi AI</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card feature-card h-100">
                    <div class="feature-icon">🎤</div>
                    <h5>Ghi Âm Giọng Nói</h5>
                    <p class="text-muted">Kể chuyện bằng giọng nói của bạn, AI sẽ biến thành truyện tranh tuyệt đẹp</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card feature-card h-100">
                    <div class="feature-icon">🔊</div>
                    <h5>Đọc Truyện Tự Động</h5>
                    <p class="text-muted">Tính năng Text-to-Speech giúp bé nghe truyện mà không cần biết đọc</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card feature-card h-100">
                    <div class="feature-icon">📄</div>
                    <h5>Xuất PDF & In Ấn</h5>
                    <p class="text-muted">Tải truyện về dạng PDF để in thành sách thật cho bé</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card feature-card h-100">
                    <div class="feature-icon">🔗</div>
                    <h5>Chia Sẻ Dễ Dàng</h5>
                    <p class="text-muted">Chia sẻ truyện với ông bà, người thân qua link đơn giản</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Sample Stories Section -->
<section class="section">
    <div class="container">
        <div class="section-header">
            <h2>Truyện Mẫu</h2>
            <p>Xem những câu chuyện tuyệt vời đã được tạo bởi GrowingTales</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card story-card h-100">
                    <div class="story-cover">🐰</div>
                    <div class="card-body">
                        <h5 class="card-title">Chú Thỏ Con Dũng Cảm</h5>
                        <p class="card-text text-muted">Câu chuyện về chú thỏ nhỏ học cách vượt qua nỗi sợ hãi</p>
                        <div class="d-flex gap-2 mb-3">
                            <span class="badge bg-light text-dark"><i class="bi bi-person me-1"></i>Bé An</span>
                            <span class="badge bg-light text-dark"><i class="bi bi-star me-1"></i>5 tuổi</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card story-card h-100">
                    <div class="story-cover">🚀</div>
                    <div class="card-body">
                        <h5 class="card-title">Cuộc Phiêu Lưu Của Bé Minh</h5>
                        <p class="card-text text-muted">Bé Minh khám phá thế giới kỳ diệu trong giấc mơ</p>
                        <div class="d-flex gap-2 mb-3">
                            <span class="badge bg-light text-dark"><i class="bi bi-person me-1"></i>Bé Minh</span>
                            <span class="badge bg-light text-dark"><i class="bi bi-star me-1"></i>6 tuổi</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card story-card h-100">
                    <div class="story-cover">🐕</div>
                    <div class="card-body">
                        <h5 class="card-title">Bạn Thân Của Bé Linh</h5>
                        <p class="card-text text-muted">Tình bạn đáng yêu giữa bé Linh và chú cún con</p>
                        <div class="d-flex gap-2 mb-3">
                            <span class="badge bg-light text-dark"><i class="bi bi-person me-1"></i>Bé Linh</span>
                            <span class="badge bg-light text-dark"><i class="bi bi-star me-1"></i>4 tuổi</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center mt-4">
            <a href="/Story/Create" class="btn btn-primary btn-lg">
                <i class="bi bi-rocket me-2"></i>Tạo Truyện Của Bạn Ngay
            </a>
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section class="section bg-light">
    <div class="container">
        <div class="section-header">
            <h2>Cách Hoạt Động</h2>
            <p>Chỉ 3 bước đơn giản để tạo truyện cho bé</p>
        </div>
        <div class="row align-items-center">
            <div class="col-md-4">
                <div class="step">
                    <div class="step-number">1</div>
                    <div class="step-icon">📝</div>
                    <h5>Nhập Ý Tưởng</h5>
                    <p class="text-muted">Nhập nội dung hoặc ghi âm ý tưởng câu chuyện của bạn</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="step">
                    <div class="step-number">2</div>
                    <div class="step-icon">🤖</div>
                    <h5>AI Tạo Truyện</h5>
                    <p class="text-muted">AI tự động tạo nội dung và hình ảnh phù hợp với bé</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="step">
                    <div class="step-number">3</div>
                    <div class="step-icon">🎉</div>
                    <h5>Thưởng Thức</h5>
                    <p class="text-muted">Đọc, nghe, in hoặc chia sẻ truyện với người thân</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Pricing Preview Section -->
<section class="section bg-gradient-primary text-white">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card bg-white text-dark p-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h3><i class="bi bi-gift me-2"></i>Ưu Đãi Đặc Biệt</h3>
                            <p class="display-6 fw-bold text-gradient mb-3">Chỉ 150.000đ/tháng</p>
                            <ul class="list-unstyled mb-4">
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Tạo truyện không giới hạn</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Hình ảnh chất lượng cao</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Xuất PDF không watermark</li>
                                <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Ưu tiên hỗ trợ</li>
                            </ul>
                            <a href="/Subscription/Pricing" class="btn btn-primary btn-lg">Xem Chi Tiết Gói</a>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="bg-gradient-primary text-white rounded-4 p-4">
                                <div class="display-4 fw-bold">150K</div>
                                <div>/tháng</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="section">
    <div class="container text-center">
        <h2 class="mb-3">Bắt Đầu Tạo Truyện Ngay Hôm Nay!</h2>
        <p class="lead text-muted mb-4">Tham gia cùng hàng nghìn phụ huynh đã tạo truyện cho con yêu</p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            @if (!User.Identity?.IsAuthenticated ?? true)
            {
                <a href="/Account/Register" class="btn btn-primary btn-lg">
                    <i class="bi bi-person-plus me-2"></i>Đăng Ký Miễn Phí
                </a>
                <a href="/Account/Login" class="btn btn-outline-primary btn-lg">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Đã Có Tài Khoản? Đăng Nhập
                </a>
            }
            else
            {
                <a href="/Story/Create" class="btn btn-primary btn-lg">
                    <i class="bi bi-stars me-2"></i>Tạo Truyện Mới
                </a>
            }
        </div>
    </div>
</section>
