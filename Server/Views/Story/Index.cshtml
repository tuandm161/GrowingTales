@model StoryListViewModel
@{
    ViewData["Title"] = "Thư viện truyện";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-collection me-2"></i>Thư Viện Truyện</h1>
        <a href="/Story/Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Tạo Truyện Mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search and Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Tìm kiếm</label>
                    <input type="text" name="search" class="form-control" placeholder="Tìm theo tiêu đề..." value="@Model.SearchTerm">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Chủ đề</label>
                    <select name="theme" class="form-select">
                        <option value="">Tất cả</option>
                        @foreach (var t in Model.AvailableThemes)
                        {
                            <option value="@t" selected="@(Model.FilterTheme == t)">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Tên bé</label>
                    <select name="childName" class="form-select">
                        <option value="">Tất cả</option>
                        @foreach (var c in Model.AvailableChildNames)
                        {
                            <option value="@c" selected="@(Model.FilterChildName == c)">@c</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Yêu thích</label>
                    <select name="favorite" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="true" selected="@(Model.FilterFavorite == true)">Yêu thích</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>Tìm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Stories Grid -->
    @if (Model.Stories.Any())
    {
        <div class="row g-4">
            @foreach (var story in Model.Stories)
            {
                <div class="col-md-4">
                    <div class="card story-card h-100 @(story.IsFavorite ? "favorite" : "")">
                        <div class="story-cover position-relative">
                            @if (!string.IsNullOrEmpty(story.CoverImageUrl) && story.CoverImageUrl.StartsWith("data:"))
                            {
                                <img src="@story.CoverImageUrl" alt="@story.Title" class="w-100 h-100" style="object-fit: cover;">
                            }
                            else
                            {
                                <span>📖</span>
                            }
                            @if (story.IsFavorite)
                            {
                                <span class="position-absolute top-0 end-0 m-2 badge bg-warning">
                                    <i class="bi bi-star-fill"></i>
                                </span>
                            }
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@story.Title</h5>
                            <p class="card-text text-muted small">@story.Description</p>
                            <div class="d-flex gap-2 mb-3 flex-wrap">
                                <span class="badge bg-light text-dark">
                                    <i class="bi bi-person me-1"></i>@story.ChildName
                                </span>
                                <span class="badge bg-light text-dark">
                                    <i class="bi bi-calendar me-1"></i>@story.ChildAge tuổi
                                </span>
                                @if (!string.IsNullOrEmpty(story.Theme))
                                {
                                    <span class="badge bg-primary">@story.Theme</span>
                                }
                            </div>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-clock me-1"></i>@story.CreatedAt.ToString("dd/MM/yyyy")
                                <span class="ms-2"><i class="bi bi-file-text me-1"></i>@story.Pages.Count trang</span>
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-0">
                            <a href="/Story/Details/@story.Id" class="btn btn-primary w-100">
                                <i class="bi bi-book me-2"></i>Đọc Truyện
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="display-1 text-muted mb-4">📚</div>
            <h3>Chưa có truyện nào</h3>
            <p class="text-muted mb-4">Bắt đầu tạo truyện đầu tiên cho bé yêu của bạn!</p>
            <a href="/Story/Create" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle me-2"></i>Tạo Truyện Ngay
            </a>
        </div>
    }
</div>
