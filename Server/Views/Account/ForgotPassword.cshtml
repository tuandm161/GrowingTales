@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GrowingTales</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="auth-page">
        <div class="auth-card fade-in">
            <div class="auth-header">
                <a href="/" class="auth-logo">
                    <i class="bi bi-book me-2"></i>GrowingTales
                </a>
                <h1 class="h3 mb-2">Quên Mật Khẩu</h1>
                <p class="text-muted">Nhập email của bạn để nhận link đặt lại mật khẩu</p>
            </div>

            @if (TempData["ForgotPasswordMessage"] != null)
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle me-2"></i>@TempData["ForgotPasswordMessage"]
                </div>
            }

            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>@TempData["InfoMessage"]
                </div>
            }

            @if (TempData["ForgotPasswordError"] != null)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-circle me-2"></i>@TempData["ForgotPasswordError"]
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                }

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="email@example.com" autofocus />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-3">
                    <i class="bi bi-envelope me-2"></i>Gửi Link Đặt Lại Mật Khẩu
                </button>
            </form>

            <div class="text-center">
                <p class="mb-0">
                    <a asp-action="Login" class="text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i>Quay lại đăng nhập
                    </a>
                </p>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
