@{
    ViewData["Title"] = "Bảng giá";
    var limits = ViewBag.UserLimits as Server.Models.UserLimitsDto;
    var subscription = ViewBag.ActiveSubscription as Server.Models.SubscriptionDto;
    var isPremium = limits?.Plan == "Premium";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1>Bảng Giá</h1>
        <p class="lead text-muted">Chọn gói phù hợp với nhu cầu của bạn</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Current Plan Status -->
    @if (User.Identity?.IsAuthenticated == true && limits != null)
    {
        <div class="card mb-4 mx-auto" style="max-width: 600px;">
            <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <span class="text-muted">Gói hiện tại:</span>
                    <span class="badge @(isPremium ? "bg-primary" : "bg-secondary") ms-2">
                        @(isPremium ? "💎 Premium" : "🆓 Miễn phí")
                    </span>
                </div>
                @if (!isPremium)
                {
                    <div class="text-muted">
                        Đã tạo: @limits.StoriesCreated/@limits.MaxStoriesAllowed truyện
                        @if (limits.StoriesRemaining > 0)
                        {
                            <span class="text-success ms-2">(Còn @limits.StoriesRemaining)</span>
                        }
                        else
                        {
                            <span class="text-danger ms-2">(Hết lượt!)</span>
                        }
                    </div>
                }
                else if (subscription != null)
                {
                    <div class="text-muted">
                        Còn @subscription.DaysRemaining ngày
                    </div>
                }
            </div>
        </div>
    }

    <!-- Pricing Cards -->
    <div class="row justify-content-center g-4">
        <!-- Free Plan -->
        <div class="col-md-5">
            <div class="card pricing-card h-100 @(!isPremium && User.Identity?.IsAuthenticated == true ? "border-success border-2" : "")">
                <div class="pricing-header free">
                    <h3 class="mb-3">🆓 Miễn Phí</h3>
                    <div class="price-amount">0đ</div>
                    <div>mãi mãi</div>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>3 truyện miễn phí</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Tối đa 5 trang/truyện</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Hình ảnh AI</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Đọc truyện bằng giọng nói</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Chia sẻ truyện</li>
                        <li class="mb-2 text-muted"><i class="bi bi-x-circle me-2"></i>Có watermark</li>
                        <li class="mb-2 text-muted"><i class="bi bi-x-circle me-2"></i>Giới hạn số truyện</li>
                    </ul>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a href="/Account/Register" class="btn btn-outline-primary w-100">
                            Đăng ký miễn phí
                        </a>
                    }
                    else if (!isPremium)
                    {
                        <div class="alert alert-success text-center mb-0">
                            <i class="bi bi-check-circle me-2"></i>Gói hiện tại
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Premium Plan -->
        <div class="col-md-5">
            <div class="card pricing-card premium h-100 position-relative @(isPremium ? "border-success border-2" : "")">
                <div class="popular-badge">🔥 Phổ biến nhất</div>
                <div class="pricing-header premium">
                    <h3 class="mb-3">💎 Premium</h3>
                    <div class="price-amount">150.000đ</div>
                    <div>/tháng</div>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Tạo truyện <strong>KHÔNG GIỚI HẠN</strong></li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Tối đa 15 trang/truyện</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Hình ảnh AI chất lượng cao</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Đọc truyện bằng giọng nói</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Chia sẻ truyện</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Không watermark</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Hỗ trợ ưu tiên</li>
                    </ul>
                    @if (isPremium)
                    {
                        <div class="alert alert-success text-center mb-0">
                            <i class="bi bi-check-circle me-2"></i>Gói hiện tại
                            @if (subscription != null)
                            {
                                <br><small>Còn @subscription.DaysRemaining ngày</small>
                            }
                        </div>
                    }
                    else if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-action="Upgrade" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                <i class="bi bi-rocket me-2"></i>Nâng cấp ngay
                            </button>
                        </form>
                    }
                    else
                    {
                        <a href="/Account/Register" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-person-plus me-2"></i>Đăng ký để nâng cấp
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Methods -->
    <div class="text-center mt-5">
        <h5 class="text-muted mb-3">Phương thức thanh toán</h5>
        <div class="d-flex justify-content-center gap-4 flex-wrap">
            <div class="bg-light rounded px-4 py-2">
                <i class="bi bi-bank me-2"></i>VNPay
            </div>
            <div class="bg-light rounded px-4 py-2">
                <i class="bi bi-credit-card me-2"></i>Thẻ ngân hàng
            </div>
            <div class="bg-light rounded px-4 py-2">
                <i class="bi bi-qr-code me-2"></i>QR Code
            </div>
        </div>
    </div>

    <!-- FAQ -->
    <div class="row justify-content-center mt-5">
        <div class="col-lg-8">
            <h4 class="text-center mb-4">Câu hỏi thường gặp</h4>
            <div class="accordion" id="faqAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                            Tôi có thể hủy gói Premium không?
                        </button>
                    </h2>
                    <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Có, bạn có thể hủy bất cứ lúc nào. Gói Premium sẽ còn hiệu lực đến hết chu kỳ thanh toán.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                            Truyện đã tạo có bị mất khi hết gói không?
                        </button>
                    </h2>
                    <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Không, tất cả truyện đã tạo sẽ được giữ nguyên. Bạn chỉ không thể tạo thêm truyện mới khi quay về gói Free.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                            Thanh toán có an toàn không?
                        </button>
                    </h2>
                    <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Hoàn toàn an toàn! Chúng tôi sử dụng VNPay - cổng thanh toán được cấp phép và bảo mật cao nhất Việt Nam.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
